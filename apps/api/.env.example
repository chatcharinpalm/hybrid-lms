DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hybrid_lms?schema=public"
# For local dev without a reachable Postgres, use SQLite instead — see the
# comment at the top of apps/api/prisma/schema.prisma for how to switch back:
# DATABASE_URL="file:./dev.db"
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"
PORT=4000
# Comma-separated if you need more than one (e.g. prod + local):
CORS_ORIGIN="http://localhost:3000"
UPLOAD_DIR="uploads"
