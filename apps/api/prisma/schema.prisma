// Hybrid LMS — Core Data Model
//
// Runs on Supabase Postgres, both the real site and development (a separate
// Supabase project — this machine can't run a Postgres server itself). Enum/
// Json/scalar-list fields are plain `String` columns (JSON-encoded where
// noted), a leftover of earlier SQLite/MySQL phases — see
// apps/api/src/constants.ts for the string-union TypeScript types they map to.

generator client {
  provider      = "prisma-client-js"
  // rhel-openssl-3.0.x: the runtime of the API's Vercel functions.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

// Supabase Postgres. DATABASE_URL = the pooled "Transaction" connection
// (port 6543, ?pgbouncer=true&connection_limit=1) used by the serverless API;
// DIRECT_URL = the direct/"Session" connection (port 5432) used by `prisma db push`.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────
// Identity & Roles
// ─────────────────────────────────────────────────────────────

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String
  firstName     String
  lastName      String
  fullName      String   // kept for display/search convenience; derived as "firstName lastName" at signup
  role          String   @default("STUDENT") // Role: ADMIN | TEACHER | STUDENT
  studentCode   String?  @unique // e.g. university/enrollment ID — required for student self-registration
  faculty       String? // e.g. คณะวิศวกรรมศาสตร์ — required for student self-registration
  major         String? // e.g. วิศวกรรมคอมพิวเตอร์ — required for student self-registration
  section       String? // class group from the official roster, e.g. "CED 2 DE-RA"
  // Students on the roster sign in with studentCode + this code, handed out on
  // paper after they sign the attendance sheet. Kept readable so staff can
  // print the slips; passwordHash always holds its hash.
  accessCode    String? @db.VarChar(16)
  avatarUrl     String? @db.VarChar(1000)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  coursesTaught     Course[]           @relation("CourseTeacher")
  enrollments       Enrollment[]
  examAttempts      ExamAttempt[]
  attendanceRecords AttendanceRecord[]
  materialsUploaded CourseMaterial[]
  auditLogs         AuditLog[]

  @@index([role])
  @@index([section])
}

// ─────────────────────────────────────────────────────────────
// Hybrid Class Management
// ─────────────────────────────────────────────────────────────

model Course {
  id          String   @id @default(uuid())
  code        String   @unique // e.g. CPE-321
  title       String
  description String? @db.Text
  termLabel   String? // e.g. 2/2567
  // Hidden from students (course list, exam center, starting its exams); staff still see it.
  isHidden    Boolean  @default(false)
  teacherId   String
  teacher     User     @relation("CourseTeacher", fields: [teacherId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  enrollments Enrollment[]
  sessions    ClassSession[]
  materials   CourseMaterial[]
  exams       Exam[]
  studyChapters StudyChapter[]
}

// Review lessons (ทบทวนบทเรียน): open any time, no timer, no anti-cheat.
// Separate from Exam so the exam system is untouched.
model StudyChapter {
  id         String   @id @default(uuid())
  courseId   String
  number     Int
  title      String
  published  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  course     Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  sections   StudySection[]
  questions  StudyQuestion[]
  worksheets StudyWorksheet[]

  @@unique([courseId, number])
}

model StudySection {
  id        String   @id @default(uuid())
  chapterId String
  order     Int
  title     String
  // Array of blocks: { type: "text", text } | { type: "image", url, alt }
  blocks    Json

  chapter   StudyChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@index([chapterId, order])
}

model StudyQuestion {
  id          String   @id @default(uuid())
  chapterId   String
  order       Int
  text        String   @db.Text
  // Array of { label, text }; answerIndex points into it
  choices     Json
  answerIndex Int
  explanation String?  @db.Text

  chapter     StudyChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@index([chapterId, order])
}

model StudyWorksheet {
  id        String   @id @default(uuid())
  chapterId String
  order     Int
  title     String
  // Same block shape as StudySection
  blocks    Json
  // Answers as blocks too; shown to students only on request
  answers   Json?

  chapter   StudyChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@index([chapterId, order])
}

model Enrollment {
  id        String   @id @default(uuid())
  courseId  String
  studentId String
  status    String   @default("ACTIVE") // ACTIVE | DROPPED | COMPLETED
  createdAt DateTime @default(now())

  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([courseId, studentId])
}

// A single scheduled class meeting, hybrid: onsite room + online link
model ClassSession {
  id            String   @id @default(uuid())
  courseId      String
  title         String
  startsAt      DateTime
  endsAt        DateTime
  onsiteRoom    String? // e.g. "Building 402"
  onlineJoinUrl String? @db.VarChar(1000) // e.g. Teams/Zoom link
  qrSecret      String? // rotating-QR seed for onsite check-in (see AttendanceRecord)
  createdAt     DateTime @default(now())

  course      Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  attendances AttendanceRecord[]

  @@index([courseId, startsAt])
}

model AttendanceRecord {
  id          String   @id @default(uuid())
  sessionId   String
  studentId   String
  method      String // AttendanceMethod: QR_ONSITE | ONLINE_JOIN | MANUAL
  checkedInAt DateTime @default(now())
  ipAddress   String?
  metadata    String? @db.Text // JSON-encoded, e.g. { token, deviceInfo }

  session ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student User         @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
}

model CourseMaterial {
  id         String   @id @default(uuid())
  courseId   String
  uploaderId String
  title      String
  type       String // MaterialType: SLIDE | VIDEO | DOCUMENT | LINK
  fileUrl    String @db.VarChar(1000) // storage path or external URL
  sizeBytes  Int?
  createdAt  DateTime @default(now())

  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  uploader User   @relation(fields: [uploaderId], references: [id])

  @@index([courseId])
}

// ─────────────────────────────────────────────────────────────
// Secure Exam Engine
// ─────────────────────────────────────────────────────────────

model Exam {
  id               String    @id @default(uuid())
  courseId         String
  title            String
  description      String? @db.Text
  durationMinutes  Int
  passScorePercent Int       @default(60)
  maxAttempts      Int       @default(1)
  status           String    @default("DRAFT") // ExamStatus: DRAFT | SCHEDULED | OPEN | CLOSED
  opensAt          DateTime?
  closesAt         DateTime?

  // Lockdown / anti-cheat configuration
  requireFullscreen Boolean @default(true)
  blockClipboard    Boolean @default(true)
  blockContextMenu  Boolean @default(true)
  maxViolations     Int     @default(3) // auto-submit threshold
  shuffleQuestions  Boolean @default(true)
  shuffleOptions    Boolean @default(true)
  // Per-question time limit, enforced server-side. Null = no per-question limit.
  // When set, students move strictly forward (no going back to earlier questions).
  timePerQuestionSeconds Int?
  // Exams imported from a teacher's document (Word/PDF): the document's own layout as JSON
  // blocks (headings, instructions, tables, images, and question blocks that reference
  // Question ids). Null for exams authored in the back office or seeded.
  paperJson String? @db.Text
  // Combined exams (several chapters in one): how many questions each student
  // draws from each group, JSON [{ group, label, count }] (see services/draw.ts).
  // Null = every question of the exam.
  drawJson String? @db.Text
  // Hidden from students (not listed, cannot be started); staff still see it.
  isHidden Boolean @default(false)
  // When a student may see their marked paper (right/wrong, the right answer, the teacher's
  // explanation): AFTER_SUBMIT | AFTER_CLOSE (once the room is closed) | NEVER.
  reviewMode String @default("AFTER_SUBMIT")
  // The rooms (User.section) that sit this exam, JSON string[]; null = every room on the class list.
  // Students of other rooms don't see it and can't start it; the monitor shows only these rooms.
  sections String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course    Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions Question[]
  attempts  ExamAttempt[]

  @@index([courseId])
}

model Question {
  id     String @id @default(uuid())
  examId String
  type   String @default("SINGLE_CHOICE") // QuestionType: SINGLE_CHOICE | MULTIPLE_CHOICE | SHORT_ANSWER | FILL_IN_BANK (pick one answer-bank entry to fill the blank) | ESSAY (written answer, not auto-graded)
  prompt String @db.Text
  points Int    @default(1)
  order  Int    @default(0) // authoring order (randomized at attempt time)
  // For SHORT_ANSWER, exact/normalized match or hash comparison
  answerKey String? @db.Text
  // Combined exams: the group (source exam) this question was copied from; its
  // Option Bank and the per-student draw go by group. Null on ordinary exams.
  group     String? @db.VarChar(64)
  // The teacher's explanation of the answer, shown to students when they review their paper.
  explanation String? @db.Text

  exam    Exam             @relation(fields: [examId], references: [id], onDelete: Cascade)
  options QuestionOption[]

  @@index([examId])
}

model QuestionOption {
  id         String  @id @default(uuid())
  questionId String
  label      String @db.VarChar(1000)
  // Answer-bank code as printed on the teacher's paper ("W", "A01", "Code 07"),
  // so answers match the paper's answer key. Null for ordinary choice questions.
  code       String? @db.VarChar(16)
  isCorrect  Boolean @default(false)
  order      Int     @default(0)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

model ExamAttempt {
  id             String    @id @default(uuid())
  examId         String
  studentId      String
  status         String    @default("IN_PROGRESS") // AttemptStatus: IN_PROGRESS | SUBMITTED | AUTO_SUBMITTED | GRADED
  startedAt      DateTime  @default(now())
  submittedAt    DateTime?
  scorePoints    Int?
  scorePercent   Float?
  passed         Boolean?
  violationCount       Int       @default(0)
  currentQuestionIndex Int       @default(0)
  // When the current question was shown; the server measures the per-question limit from here.
  currentQuestionStartedAt DateTime?
  // Extra time granted by a proctor on top of the exam's durationMinutes (untimed-per-question exams).
  extraTimeSeconds Int @default(0)

  // Per-student randomization seed so question/option order is
  // reproducible for grading/review but unique per attempt.
  randomSeed String

  exam       Exam               @relation(fields: [examId], references: [id], onDelete: Cascade)
  student    User               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers    ExamAnswer[]
  violations ExamViolationLog[]
  messages   ProctorMessage[]

  // Why the attempt ended: STUDENT | TIMEOUT | VIOLATIONS | ADMIN_FORCED | EXAM_CLOSED
  endedReason String?
  // Set when a proctor resets the attempt: it stays on record (the gradebook shows it)
  // but no longer counts, and the student may start again.
  archivedAt DateTime?

  @@index([examId, studentId])
}

// Warning sent from the back office to one student's exam screen.
model ProctorMessage {
  id        String    @id @default(uuid())
  attemptId String
  message   String    @db.Text
  createdAt DateTime  @default(now())
  seenAt    DateTime?

  attempt ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId])
}

model ExamAnswer {
  id                String   @id @default(uuid())
  attemptId         String
  questionId        String
  selectedOptionIds String   @db.VarChar(1000) @default("[]") // JSON-encoded string[], for single/multiple choice
  textAnswer        String? @db.Text // for short answer / flag submission
  isCorrect         Boolean?
  pointsAwarded     Int?
  answeredAt        DateTime @default(now())

  attempt ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
}

// Anti-cheat violation log — one row per detected event.
// type is a ViolationType (see constants.ts): TAB_HIDDEN, WINDOW_BLUR,
// FULLSCREEN_EXIT, COPY_ATTEMPT, PASTE_ATTEMPT, CUT_ATTEMPT,
// CONTEXT_MENU_ATTEMPT, DEVTOOLS_SHORTCUT, PRINT_SCREEN,
// MULTIPLE_DISPLAYS_DETECTED
model ExamViolationLog {
  id         String   @id @default(uuid())
  attemptId  String
  type       String
  occurredAt DateTime @default(now())
  detail     String? @db.Text // JSON-encoded, e.g. { durationMs, key, screenCount }

  attempt ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId, type])
}

// Site-wide switches set from the back office, e.g. key "hiddenMenus" =
// JSON string[] of student-portal menus to hide ("courses", "attendance").
model SiteSetting {
  key       String   @id
  value     String   @db.Text // JSON-encoded
  updatedAt DateTime @updatedAt
}

// Generic audit trail for admin/security review
model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  metadata  String? @db.Text // JSON-encoded
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entity, entityId])
}
